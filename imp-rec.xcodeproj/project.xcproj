    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "imp-rec",
      "target-membership": [
        "imp-rec",
      ],
      "membership-exceptions": [
        {
          "target": "imp-rec",
          "exclusions": [
            "Info.plist",
            "imp-rec.entitlements",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/ImpRec.app", "id": "08FB77A100000008FE841550", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "imp-rec",
      "id": "08FB77F100000001FE841550",
      "product": "Products/ImpRec.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "imp-rec/imp-rec.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "DEAD_CODE_STRIPPING": "YES",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "INFOPLIST_FILE": "imp-rec/Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.graphics-design",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.rxliuli.imp-rec",
        "PRODUCT_NAME": "ImpRec",
        "SWIFT_VERSION": "5.0",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ENABLE_MODULES": "YES",
